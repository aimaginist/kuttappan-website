---
import { ArrowLeft, ArrowRight, CalendarDays, Clock3, Play as WatchIcon, Share2 } from '@lucide/astro';

import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeFacade from '../../components/YouTubeFacade.astro';
import { episodes, formatDuration, formatEpisodeDate, splitEpisodeTitle, type Episode } from '../../lib/episodes';

export function getStaticPaths() {
  return episodes.map((episode) => ({params: {slug: episode.slug}, props: {episode}}));
}

type Props = { episode: Episode };
const {episode} = Astro.props;
const title = splitEpisodeTitle(episode.title);
const duration = formatDuration(episode.duration);
const index = episodes.findIndex((item) => item.videoId === episode.videoId);
const previous = index < episodes.length - 1 ? episodes[index + 1] : null;
const next = index > 0 ? episodes[index - 1] : null;

const videoSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: episode.title,
  description: episode.synopsis || episode.description,
  thumbnailUrl: [episode.thumbnail],
  uploadDate: episode.publishedAt,
  embedUrl: `https://www.youtube-nocookie.com/embed/${episode.videoId}`,
  contentUrl: `https://www.youtube.com/watch?v=${episode.videoId}`,
};
if (episode.duration) videoSchema.duration = `PT${episode.duration}S`;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {'@type': 'ListItem', position: 1, name: 'Home', item: 'https://kuttappan.in'},
    {'@type': 'ListItem', position: 2, name: 'Episodes', item: 'https://kuttappan.in/episodes'},
    {'@type': 'ListItem', position: 3, name: episode.title, item: `https://kuttappan.in/episodes/${episode.slug}`},
  ],
};
---

<BaseLayout title={`${episode.title} | Kuttappan`} description={episode.synopsis || episode.description} image={episode.thumbnail} imageAlt={`YouTube thumbnail for ${episode.title}.`} ogType="video.other" schema={[videoSchema, breadcrumb]}>
  <article class="episode-detail">
    <header class="episode-detail-header page-shell">
      <a class="episode-back" href="/episodes"><ArrowLeft size={16} aria-hidden="true" /> All episodes</a>
      <div class="episode-detail-index">Episode {String(index + 1).padStart(2, '0')}</div>
      <h1 class:list={[{'malayalam': /[\u0D00-\u0D7F]/.test(title.primary)}]} lang={/[\u0D00-\u0D7F]/.test(title.primary) ? 'ml' : 'en'}>{title.primary}</h1>
      {title.secondary && <p class="episode-detail-secondary">{title.secondary}</p>}
      <div class="episode-detail-meta">
        <span><CalendarDays size={15} aria-hidden="true" /> {formatEpisodeDate(episode.publishedAt)}</span>
        {duration && <span><Clock3 size={15} aria-hidden="true" /> {duration}</span>}
      </div>
    </header>

    <div class="episode-screening page-shell" data-reveal>
      <YouTubeFacade videoId={episode.videoId} title={episode.title} thumbnail={episode.thumbnail} />
    </div>

    <div class="episode-story page-shell">
      <div data-reveal>
        <p class="section-kicker">About this episode</p>
        {episode.synopsis && <p class="episode-synopsis">{episode.synopsis}</p>}
      </div>
      <div class="episode-actions" data-reveal>
        <a class="button button-gold" href={`https://www.youtube.com/watch?v=${episode.videoId}`} target="_blank" rel="noreferrer"><WatchIcon size={18} fill="currentColor" aria-hidden="true" /> Watch on YouTube</a>
        <div class="share-action">
          <button class="share-button" type="button" data-share><Share2 size={17} aria-hidden="true" /> Share episode</button>
          <p class="share-status" data-share-status role="status" aria-live="polite"></p>
        </div>
      </div>
    </div>

    <nav class="episode-pagination page-shell" aria-label="Episode navigation">
      {previous ? <a href={`/episodes/${previous.slug}`}><ArrowLeft size={18} aria-hidden="true" /><span>Previous episode</span><strong>{splitEpisodeTitle(previous.title).primary}</strong></a> : <span></span>}
      {next ? <a href={`/episodes/${next.slug}`}><span>Next episode</span><strong>{splitEpisodeTitle(next.title).primary}</strong><ArrowRight size={18} aria-hidden="true" /></a> : <span></span>}
    </nav>
  </article>
</BaseLayout>
