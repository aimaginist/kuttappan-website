---
type Props = {
  index: string;
  kicker: string;
  title: string;
  copy?: string;
  light?: boolean;
};
const {index, kicker, title, copy, light = false} = Astro.props;
---

<div class:list={['section-heading', {'section-heading-light': light}]} data-reveal>
  <div class="section-heading-index"><span>{index}</span><i></i><span>{kicker}</span></div>
  <h2>{title}</h2>
  {copy && <p>{copy}</p>}
</div>
